# The deployment script replaces CALLBACK_HOST with the discovered sslip.io name.
CALLBACK_HOST {
    handle /executor-pubkey.json {
        root * /srv
        file_server
    }
    handle /health {
        header Content-Type application/json
        respond `{"status":"ok","phase":"P1","application_ready":false}` 200
    }
    handle {
        respond "Callback infrastructure is online. Application build is in progress." 200
    }
    log {
        output stdout
        format json
    }
}
